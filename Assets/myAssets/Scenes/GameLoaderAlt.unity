  m_Name: 
  m_EditorClassIdentifier: 
  LocalizationKey: 
  LocalizationParameter: 
  IsCustomText: 1
  EnCustomText: "\u0412 \u0440\u0435\u0436\u0438\u043C\u0435 Offline \u043D\u0438\u043A\u0430\u043A\u0438\u0435
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u043D\u0435 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u044E\u0442\u0441\u044F
    \u043D\u0430 \u0441\u0435\u0440\u0432\u0435\u0440\u0435. \u0412 \u0440\u0435\u0436\u0438\u043C\u0435
    Online \u0432\u0441\u0435 \u043E\u0442\u0441\u0440\u043E\u0447\u0435\u043D\u043D\u044B\u0435
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u044E\u0442\u0441\u044F
    \u043D\u0430 \u0441\u0435\u0440\u0432\u0435\u0440. \u0415\u0441\u043B\u0438 \u043D\u0435
    \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0442\u044C
    \u0434\u0430\u043D\u043D\u044B\u0435 \u043F\u043E\u0441\u043B\u0435 \u0441\u0435\u0430\u043D\u0441\u0430
    offline - \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \u043A\u043D\u043E\u043F\u043A\u0443
    \"\u041F\u0435\u0440\u0435\u0437\u0430\u043F\u0443\u0441\u043A \u0438\u0433\u0440\u044B\""
