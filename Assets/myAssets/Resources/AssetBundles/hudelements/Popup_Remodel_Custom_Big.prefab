  mText: "\u0422\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439: \u042D\u0442\u043E\u0442
    \u0432\u044B\u0436\u0438\u0432\u0448\u0438\u0439 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442
    \u043D\u0430 10% \u043C\u0435\u043D\u044C\u0448\u0435 \u0443\u0440\u043E\u043D\u0430.
    \u041E\u043D \u0442\u0430\u043A\u0436\u0435 \u043C\u043E\u0436\u0435\u0442 \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F
    \u043F\u043E\u0441\u043B\u0435 \u0430\u0442\u0430\u043A\u0438, \u0435\u0441\u043B\u0438
    \u043D\u0435 \u0434\u0432\u0438\u0433\u0430\u043B\u0441\u044F \u0434\u043E \u043D\u0435\u0435.
    \u041E\u0431\u0449\u0430\u044F \u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u044F\u0435\u043C\u043E\u0441\u0442\u044C
