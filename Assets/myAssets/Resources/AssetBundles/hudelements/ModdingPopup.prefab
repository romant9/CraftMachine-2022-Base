--- !u!114 &9091030092136301138
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6924435018878386996}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 702e1cc3b8be6183844dfba805d8000e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  LocalizationKey: 
  LocalizationParameter: 
  IsCustomText: 1
  Prefab: {fileID: 0}
  ActivateOnHover: 0
  EnCustomText: "\u0412\u043A\u043B\u044E\u0447\u0438\u0442\u044C / \u0412\u044B\u043A\u043B\u044E\u0447\u0438\u0442\u044C
    \u0423\u043A\u043B\u043E\u043D\u0435\u043D\u0438\u0435 \u0438 \u0423\u043A\u043B\u043E\u043D\u0435\u043D\u0438\u0435
    \u043E\u0442 \u043F\u0443\u043B\u044C.\n\u0423\u043A\u043B\u043E\u043D\u0435\u043D\u0438\u0435
    \u0431\u0443\u0434\u0435\u0442 \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C,
    \u0442\u043E\u043B\u044C\u043A\u043E \u0435\u0441\u043B\u0438 \u0441\u0440\u0435\u0434\u0438
    \u043D\u0430\u0432\u043A\u043E\u0432 \u0433\u0435\u0440\u043E\u044F \u0438\u043B\u0438
    \u043E\u0440\u0443\u0436\u0438\u044F \u0435\u0441\u0442\u044C \u0423\u043A\u043B\u043E\u043D\u0435\u043D\u0438\u0435.\n\u0412
    \u0442\u0435\u0447\u0435\u043D\u0438\u0435 \u0431\u043E\u044F \u043D\u0435 \u043F\u0435\u0440\u0435\u0437\u0430\u0433\u0440\u0443\u0436\u0430\u0439\u0442\u0435
    \u0438\u0433\u0440\u0443, \u0438\u043D\u0430\u0447\u0435 \u0431\u0443\u0434\u0435\u0442
    \u043E\u0442\u043A\u0430\u0442 \u043A \u0438\u0441\u0445\u043E\u0434\u043D\u043E\u043C\u0443
    \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u044E. \n\u0412\u043A\u043B\u044E\u0447\u0430\u0442\u044C
    \u0443\u043A\u043B\u043E\u043D\u0435\u043D\u0438\u0435 \u041E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E
    \u043D\u0443\u0436\u043D\u043E \u043D\u0435 \u0440\u0430\u043D\u0435\u0435 \u0437\u0430\u0445\u043E\u0434\u0430
    \u0432 \u043C\u0438\u0441\u0441\u0438\u044E"
  RuCustomText: 
  DoNotSaveToClipboard: 0
