  IsCustomText: 1
  Prefab: {fileID: 0}
  ActivateOnHover: 0
  EnCustomText: "\u0412\u043A\u043B\u044E\u0447\u0438\u0442\u044C / \u0412\u044B\u043A\u043B\u044E\u0447\u0438\u0442\u044C
    \u0430\u043D\u0430\u043B\u0438\u0442\u0438\u043A\u0443 (\u043E\u0442\u043F\u0440\u0430\u0432\u043A\u0443
    \u043B\u043E\u0433\u0430 \u043D\u0430 \u0441\u0435\u0440\u0432\u0435\u0440).
    \u0417\u043D\u0430\u0447\u0435\u043D\u0438\u0435 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442\u0441\u044F
    \u0432 \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0430\u0445 \u0438 \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F
    \u043F\u0440\u0438 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C \u0437\u0430\u043F\u0443\u0441\u043A\u0435.\n\u041F\u0440\u0438\u043C\u0435\u043D\u044F\u0442\u044C
    \u0441 \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E\u0441\u0442\u044C\u044E.
    \u0411\u0435\u0437 \u0430\u043D\u0430\u043B\u0438\u0442\u0438\u043A\u0438 \u043D\u0438\u043A\u0430\u043A\u0438\u0435
    \u0432\u0430\u0448\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u043D\u0435
    \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u044E\u0442\u0441\u044F."
