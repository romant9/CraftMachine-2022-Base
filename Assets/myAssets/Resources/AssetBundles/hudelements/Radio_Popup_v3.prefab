--- !u!114 &9005738376475309928
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3515311005907002548}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 702e1cc3b8be6183844dfba805d8000e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  LocalizationKey: 
  LocalizationParameter: 
  IsCustomText: 1
  Prefab: {fileID: 0}
  ActivateOnHover: 0
  EnCustomText: 'Click the button (3 tokens) to check the queue of calls with the
    highest value (JACKPOT). Specify three call types to analyze when searching for
    the JACKPOT: 1. Expensive (searching for a hero), 2. Minimal (approaching the
    jackpot), and 3. Regular (rolling a hero).



    You can stop the check at any
    time by clicking the button again. All heroes with a jackpot are recorded during
    the check. At the end of the check, you get a list of preferred heroes, which
    displays the following values: 1. Hero, 2. Number of calls, 3. Spent radios.



    (!)
    To reach the jackpot if a hero is not found or the number of expensive calls
    is more than one, use calls of the same type but with a lower cost. For example,
    any "Guaranteed Hero" challenge for 120 or 40 will move you closer to the jackpot
    challenge for 1200. When you''re 1-2 challenges away from the jackpot, use ANY
    challenge with an index greater than 2 (preferably 2 or 3) to change the winning
    hero.'
  RuCustomText: "\u041D\u0430\u0436\u0438\u043C\u0430\u0439\u0442\u0435 \u043D\u0430
    \u043A\u043D\u043E\u043F\u043A\u0443 (3 \u0442\u043E\u043A\u0435\u043D\u0430)
    \u0434\u043B\u044F \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438 \u043E\u0447\u0435\u0440\u0435\u0434\u0438
    \u0432\u044B\u0437\u043E\u0432\u043E\u0432 \u0441 \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u043C
    \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435\u043C (\u0414\u0416\u0415\u041A\u041F\u041E\u0422).
    \u0423\u043A\u0430\u0436\u0438\u0442\u0435 3 \u0442\u0438\u043F\u0430 \u0432\u044B\u0437\u043E\u0432\u0430,
    \u0430\u043D\u0438\u043B\u0438\u0437\u0438\u0440\u0443\u0435\u043C\u044B\u0435
    \u043F\u0440\u0438 \u043F\u043E\u0438\u0441\u043A\u0435 \u0414\u0416\u0415\u041A\u041F\u041E\u0422\u0410
    - 1.\u0434\u043E\u0440\u043E\u0433\u043E\u0439 (\u0438\u0449\u0435\u043C \u0433\u0435\u0440\u043E\u044F),
    2.\u043C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u0439 (\u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0430\u0435\u043C
    \u0434\u0436\u0435\u043A\u043F\u043E\u0442) \u0438 3.\u0440\u0435\u0433\u0443\u043B\u044F\u0440\u043D\u044B\u0439
    (\u043F\u0435\u0440\u0435\u043A\u0430\u0442 \u0433\u0435\u0440\u043E\u044F).
    \r\n\u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0432\u043B\u044E\u0431\u043E\u0439
    \u043C\u043E\u043C\u0435\u043D\u0442 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
    \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0443, \u0435\u0449\u0435 \u0440\u0430\u0437
    \u043D\u0430\u0436\u0430\u0432 \u043D\u0430 \u043A\u043D\u043E\u043F\u043A\u0443.
    \u041F\u0440\u0438 \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0435 \u0444\u0438\u043A\u0441\u0438\u0440\u0443\u044E\u0442\u0441\u044F
    \u0432\u0441\u0435 \u0433\u0435\u0440\u043E\u0438 \u0441 \u0434\u0436\u0435\u043A\u043F\u043E\u0442\u043E\u043C.
    \u0412 \u043A\u043E\u043D\u0446\u0435 \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438
    \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u043C \u0441\u043F\u0438\u0441\u043E\u043A
    \u043F\u0440\u0435\u0434\u043F\u043E\u0447\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u0433\u0435\u0440\u043E\u0435\u0432, \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u043C
    \u0443\u043A\u0430\u0437\u0430\u043D\u044B \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F:
    1.\u0413\u0435\u0440\u043E\u0439, 2.\u0427\u0438\u0441\u043B\u043E \u0432\u044B\u0437\u043E\u0432\u043E\u0432,
    3.\u041F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u043D\u044B\u0435 \u0440\u0430\u0446\u0438\u0438.
    \r\n(!) \u0427\u0442\u043E\u0431\u044B \u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F
    \u0434\u043E \u0434\u0436\u0435\u043A\u043F\u043E\u0442\u0430 \u0432 \u0441\u043B\u0443\u0447\u0430\u044F\u0445,
    \u0435\u0441\u043B\u0438 \u0433\u0435\u0440\u043E\u0439 \u043D\u0435 \u043D\u0430\u0439\u0434\u0435\u043D
    \u0438\u043B\u0438 \u0447\u0438\u0441\u043B\u043E \u0434\u043E\u0440\u043E\u0433\u0438\u0445
    \u0432\u044B\u0437\u043E\u0432\u043E\u0432 \u0431\u043E\u043B\u0435\u0435 1 -
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u0432\u044B\u0437\u043E\u0432\u044B
    \u043E\u0434\u043D\u043E\u0433\u043E \u0442\u0438\u043F\u0430, \u043D\u043E \u043C\u0435\u043D\u044C\u0448\u0435\u0439
    \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u0438. \u041D\u0430\u043F\u0440\u0438\u043C\u0435\u0440
    \u043B\u044E\u0431\u043E\u0439 \u0432\u044B\u0437\u043E\u0432 \"\u0413\u0430\u0440\u0430\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
    \u0433\u0435\u0440\u043E\u0439\" \u0437\u0430 120 \u0438\u043B\u0438 \u0437\u0430
    40 \u0431\u0443\u0434\u0435\u0442 \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0430\u0442\u044C
    \u0434\u0436\u0435\u043A\u043F\u043E\u0442 \u0432\u044B\u0437\u043E\u0432\u0430
    \u0437\u0430 1200. \u041A\u043E\u0433\u0434\u0430 \u0434\u043E \u0434\u0436\u0435\u043A\u043F\u043E\u0442\u0430
    \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F 1-2 \u0432\u044B\u0437\u043E\u0432\u0430,
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u041B\u042E\u0411\u041E\u0419
    \u0432\u044B\u0437\u043E\u0432 \u0441 \u0438\u043D\u0434\u0435\u043A\u0441\u043E\u043C
    \u0431\u043E\u043B\u044C\u0448\u0435 2 (\u043F\u0440\u0435\u0434\u043F\u043E\u0447\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    2 \u0438\u043B\u0438 3), \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043C\u0435\u043D\u044F\u0442\u044C
    \u0432\u044B\u0438\u0433\u0440\u044B\u0448\u043D\u043E\u0433\u043E \u0433\u0435\u0440\u043E\u044F."
