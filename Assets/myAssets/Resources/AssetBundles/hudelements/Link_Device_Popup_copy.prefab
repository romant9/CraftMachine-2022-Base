--- !u!114 &5114430435103210577
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1511258494272445331}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 702e1cc3b8be6183844dfba805d8000e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  LocalizationKey: Popup.Settings.AutomaticCovering.Tooltip
  LocalizationParameter: 
  IsCustomText: 1
  Prefab: {fileID: 0}
  ActivateOnHover: 0
  EnCustomText: 'Link by code from any game client. For Pro-users it is possible
    to link accounts from the list over the current account.

    !!! It is possible
    to link an account from the list from the start (without preliminary loading)!!!'
  RuCustomText: "\u041B\u0438\u043D\u043A\u0443\u0435\u043C\u0441\u044F \u043F\u043E
    \u043A\u043E\u0434\u0443 \u0438\u0437 \u043B\u044E\u0431\u043E\u0433\u043E \u043A\u043B\u0438\u0435\u043D\u0442\u0430
    \u0438\u0433\u0440\u044B. \u0414\u043B\u044F \u041F\u0440\u043E-\u044E\u0437\u0435\u0440\u043E\u0432
    \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E \u043B\u0438\u043D\u043A\u043E\u0432\u0430\u0442\u044C
    \u0430\u043A\u043A\u0430\u0443\u043D\u0442\u044B \u0438\u0437 \u0441\u043F\u0438\u0441\u043A\u0430
    \u043F\u043E\u0432\u0435\u0440\u0445 \u0442\u0435\u043A\u0443\u0449\u0435\u0433\u043E
    \u0430\u043A\u043A\u0430\u0443\u043D\u0442.\n!!! \u041C\u043E\u0436\u043D\u043E
    \u043B\u0438\u043D\u043A\u043E\u0432\u0430\u0442\u044C \u0430\u043A\u043A\u0430\u0443\u043D\u0442
