  RuCustomText: "\u0410\u0432\u0442\u043E \u0432\u044B\u0437\u043E\u0432. \u041F\u043E\u0438\u0441\u043A
    \u0432 \u043F\u0440\u0435\u0434\u0435\u043B\u0430\u0445 \u0437\u0430\u0434\u0430\u043D\u043D\u043E\u0433\u043E
    \u0447\u0438\u0441\u043B\u0430 \u0440\u0430\u0446\u0438\u0439 \u043D\u0443\u0436\u043D\u043E\u0433\u043E
    \u0442\u0438\u043F\u0430 \u043D\u0430\u0433\u0440\u0430\u0434. \u041C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E
    300 \u043F\u0435\u0440\u0435\u043A\u0430\u0442\u043E\u0432. \u0414\u043B\u044F
    \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u0437\u0430\u043F\u0443\u0449\u0435\u043D\u043D\u043E\u0433\u043E
    \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0430 \u043E\u0442\u043A\u043B\u044E\u0447\u0438\u0442\u0435
    \u0442\u0440\u0438\u0433\u0433\u0435\u0440 \u0410\u0432\u0442\u043E\u0432\u044B\u0437\u043E\u0432"
